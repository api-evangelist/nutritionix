          "name": "Nutritionix Search Instant",
          "request": {
            "name": "Nutritionix Search Instant",
            "description": {
              "content": "Typeahead search that returns matched common foods and branded foods for a partial or complete query string. Ideal for building food autocomplete experiences.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search",
                "instant"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) The food search phrase to match against common and branded foods."
                },
                {
                  "disabled": false,
                  "key": "branded",
                  "value": "true",
                  "description": "Whether to include branded foods in the results."
                },
                {
                  "disabled": false,
                  "key": "common",
                  "value": "true",
                  "description": "Whether to include common foods in the results."
                },
                {
                  "disabled": false,
                  "key": "detailed",
                  "value": "false",
                  "description": "Whether to return full nutrient detail for each result."
                },
                {
                  "disabled": false,
                  "key": "branded_type",
                  "value": "<integer>",
                  "description": "Filter branded results by type (1 for restaurant, 2 for grocery/CPG)."
                },
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en_US",
                  "description": "Locale code used to localize results (e.g. en_US)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
